# Copy to .env and fill in the real values. .env is gitignored.
# Atlas connection string. Leave ((db_name)) in place: it is substituted at
# runtime with the stage's DB_NAME env var, so one URI serves every stage.
# Round brackets, not braces - AWS Param Store rejects values containing "{{}}".
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/((db_name))?retryWrites=true&w=majority
