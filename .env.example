# Copy to .env and fill in the real values. .env is gitignored.
#
# The blog stores its posts as JSON objects in this S3 bucket. Running
# `sls offline` locally talks to the real bucket, so the shell also needs AWS
# credentials (via `aws configure`, AWS_PROFILE, or AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY) with read/write access to it.
BUCKET_NAME=lytebuy-blog-development-us-west-2

# Optional: region and AWS profile for local runs. AWS_PROFILE is applied only
# under `sls offline` (IS_OFFLINE=true); a deployed Lambda ignores it and uses
# its execution role.
# REGION=us-west-2
# AWS_PROFILE=lytebuy-dev
